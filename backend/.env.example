# Pixel Agency backend. Copy to .env for local development; set these in the
# Render dashboard in production. Never commit real values.

NODE_ENV=development
PORT=10001
LOG_LEVEL=info

# Postgres. All tables live in the `pixel_agency` schema.
DATABASE_URL=postgres://postgres:test@localhost:55433/postgres
DATABASE_SSL=disable

# Signs the game's own session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
SESSION_TTL_MINUTES=720

# AI Arena API gateway origin (the same value as the web app's NEXT_PUBLIC_API_URL).
AI_ARENA_API_URL=http://localhost:8000

# ai-infrastructure and this game's service key there (scopes: football:read, football:predict).
# Create the key in ai-infrastructure with `pnpm keygen`, add it to its SERVICE_KEYS,
# and put the same id and secret here.
AI_INFRA_URL=http://localhost:10000
AI_INFRA_KEY_ID=pixel-agency
AI_INFRA_SECRET=

# The game's web origin(s), comma separated. No wildcards.
CORS_ORIGINS=http://localhost:5173

# Gameplay
LOCK_MINUTES_BEFORE_KICKOFF=5
MAX_ANALYSES_PER_FIXTURE=3
WORKER_INTERVAL_SECONDS=300

# Integration tests (docker compose up -d)
# TEST_DATABASE_URL=postgres://postgres:test@localhost:55433/postgres

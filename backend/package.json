{
  "name": "pixel-agency-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Pixel Agency game backend: AI football analysis agencies, predictions, scoring and leaderboards",
  "main": "dist/main.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.0.9",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "dev": "tsx watch src/main.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "migrate": "node dist/storage/migrate.js",
    "migrate:dev": "tsx src/storage/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "dotenv": "^16.6.1",
    "fastify": "^5.4.0",
    "pg": "^8.16.3",
    "pino": "^9.7.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/pg": "^8.15.4",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^5.0.2"
  }
}
